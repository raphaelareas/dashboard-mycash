// schema.prisma - mycash+ v2.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 👤 USUÁRIOS E AUTENTICAÇÃO
// ============================================
// User representa a CONTA autenticada (login único)
// Um User pode ter múltiplos FamilyMembers associados

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  familyMembers      FamilyMember[]
  accounts           Account[]
  transactions       Transaction[]
  categories         Category[]
  recurringTemplates RecurringTransaction[]

  @@map("users")
}

// ============================================
// 👨‍👩‍👧‍👦 MEMBROS DA FAMÍLIA
// ============================================
// FamilyMember representa PESSOAS da família
// Podem ser várias (pai, mãe, filhos, etc)
// O próprio User pode ter um FamilyMember associado

model FamilyMember {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  role          String // "Pai", "Mãe", "Filho", "Filha", "Avô", "Avó", etc
  avatarUrl     String?  @map("avatar_url")
  monthlyIncome Decimal  @default(0) @map("monthly_income") @db.Decimal(12, 2)
  color         String   @default("#3247FF") // Cor do avatar no sistema
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relações
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountsAsHolder      Account[]              @relation("AccountHolder")
  transactions          Transaction[]          @relation("TransactionMember")
  recurringTransactions RecurringTransaction[] @relation("RecurringMember")

  @@index([userId])
  @@map("family_members")
}

// ============================================
// 🏷️ CATEGORIAS
// ============================================

model Category {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  name      String
  icon      String          @default("📌")
  type      TransactionType // INCOME ou EXPENSE
  color     String          @default("#3247FF")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  // Relações
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, type])
  @@map("categories")
}

// ============================================
// 💳 CONTAS E CARTÕES (UNIFICADO)
// ============================================
// Account UNIFICA contas bancárias e cartões de crédito
// Type define se é CHECKING, SAVINGS ou CREDIT_CARD
// Campos condicionais são validados no código

model Account {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  type       AccountType // CHECKING, SAVINGS ou CREDIT_CARD
  name       String // Nome/Apelido (ex: "Nubank", "Itaú Mastercard")
  bank       String // Banco/Instituição (ex: "Nubank", "Itaú")
  lastDigits String?     @map("last_digits") // 4 últimos dígitos (OPCIONAL)
  holderId   String      @map("holder_id") // Titular obrigatório
  
  // ============================================
  // 💰 CAMPOS PARA CONTA CORRENTE E POUPANÇA
  // ============================================
  // Usado quando type = CHECKING ou SAVINGS
  balance Decimal @default(0) @db.Decimal(12, 2) // Saldo atual
  
  // ============================================
  // 💳 CAMPOS PARA CARTÃO DE CRÉDITO
  // ============================================
  // Usado quando type = CREDIT_CARD
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2) // Limite total
  currentBill Decimal  @default(0) @map("current_bill") @db.Decimal(12, 2) // Fatura atual
  dueDay      Int?     @map("due_day") // Dia do vencimento (1-31)
  closingDay  Int?     @map("closing_day") // Dia do fechamento (1-31)
  theme       String?  @default("black") // "black", "lime", "white"
  logoUrl     String?  @map("logo_url") // Logo do banco (opcional)
  
  // ============================================
  // 🔧 METADATA
  // ============================================
  color     String   @default("#3247FF")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  holder                FamilyMember           @relation("AccountHolder", fields: [holderId], references: [id])
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, type])
  @@index([holderId])
  @@map("accounts")
}

// ============================================
// 💰 TRANSAÇÕES
// ============================================

model Transaction {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime        @db.Date
  categoryId  String?         @map("category_id")
  accountId   String?         @map("account_id")
  memberId    String?         @map("member_id") // Membro responsável (opcional)
  
  // ============================================
  // 💳 PARCELAMENTO (Máximo 12 parcelas)
  // ============================================
  // REGRA: totalInstallments entre 1 e 12 (padrão brasileiro)
  // REGRA: Se isRecurring = true, totalInstallments DEVE ser 1
  installmentNumber   Int?    @map("installment_number") // Parcela atual (1, 2, 3...)
  totalInstallments   Int     @default(1) @map("total_installments") // Total de parcelas (1x até 12x)
  parentTransactionId String? @map("parent_transaction_id") // ID da transação pai (primeira parcela)
  
  // ============================================
  // 🔁 RECORRÊNCIA
  // ============================================
  // REGRA: Se isRecurring = true, totalInstallments DEVE ser 1
  // Transação recorrente NÃO pode ser parcelada
  isRecurring            Boolean @default(false) @map("is_recurring")
  recurringTransactionId String? @map("recurring_transaction_id") // ID do template recorrente
  
  // ============================================
  // ✅ STATUS
  // ============================================
  status TransactionStatus @default(COMPLETED)
  notes  String?
  
  // ============================================
  // 🔧 METADATA
  // ============================================
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account           Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  member            FamilyMember?         @relation("TransactionMember", fields: [memberId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  
  // Relação hierárquica para parcelas
  parentTransaction Transaction?  @relation("TransactionInstallments", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  childTransactions Transaction[] @relation("TransactionInstallments")

  @@index([userId, date])
  @@index([categoryId])
  @@index([accountId])
  @@index([memberId])
  @@index([recurringTransactionId])
  @@index([parentTransactionId])
  @@index([status])
  @@map("transactions")
}

// ============================================
// 💫 DESPESAS RECORRENTES (TEMPLATE)
// ============================================
// Armazena templates de transações recorrentes
// Gera automaticamente transações reais baseadas na frequência

model RecurringTransaction {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  type        TransactionType @default(EXPENSE)
  amount      Decimal         @db.Decimal(12, 2)
  description String
  categoryId  String?         @map("category_id")
  accountId   String?         @map("account_id")
  memberId    String?         @map("member_id")
  
  // ============================================
  // 🔁 CONFIGURAÇÃO DE RECORRÊNCIA
  // ============================================
  frequency  RecurrenceFrequency // DAILY, WEEKLY, MONTHLY, YEARLY
  dayOfMonth Int?                @map("day_of_month") // Ex: dia 21 (para recorrência mensal)
  dayOfWeek  Int?                @map("day_of_week") // 0-6 (para recorrência semanal)
  startDate  DateTime            @map("start_date") @db.Date
  endDate    DateTime?           @map("end_date") @db.Date // Opcional
  
  // ============================================
  // 🔧 METADATA
  // ============================================
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account               Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  member                FamilyMember?  @relation("RecurringMember", fields: [memberId], references: [id], onDelete: SetNull)
  generatedTransactions Transaction[] // Transações geradas por este template

  @@index([userId, isActive])
  @@index([categoryId])
  @@index([accountId])
  @@map("recurring_transactions")
}

// ============================================
// 🔧 ENUMS
// ============================================

enum TransactionType {
  INCOME  // Receita
  EXPENSE // Despesa
}

enum AccountType {
  CHECKING    // Conta corrente
  SAVINGS     // Poupança
  CREDIT_CARD // Cartão de crédito
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionStatus {
  PENDING   // Pendente (Toggle "Pendente" no modal)
  COMPLETED // Concluído (Toggle "Concluído" no modal)
}
